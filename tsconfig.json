{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // `vite/client` declares `import.meta.env` (BASE_URL), which src/main.tsx
    // uses to locate the service worker.
    "types": ["vite/client"]
  },
  "include": ["src/**/*"]
}